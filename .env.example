# Copy to .env.local (gitignored) and fill in. Never commit real values.
# Server-side only (read by the FastAPI backend, never sent to the browser):
JEV_API_KEY=            # TypeSafe System One (https://api.typesafe.ai/v1/systemone, model jev-latest); optional, rules used without it
GROQ_API_KEY=           # plain-language summaries; optional, template used without it
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=         # fallback when Groq fails or is rate-limited; key is sent in a header, never the URL
GEMINI_MODEL=gemini-2.5-flash-lite
# Image model used to mark harvested parts on botanical illustrations (scripts/annotate_illustrations.py, /api/species/{name}/illustration)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
SPECIESPLUS_TOKEN=      # CITES Species+ API; optional, CITES layer pending without it
NASA_FIRMS_MAP_KEY=     # NASA FIRMS area API (firms.modaps.eosdis.nasa.gov/api/map_key); optional, fire layer pending without it
TAVILY_API_KEY=         # not used yet
GBIF_USERNAME=          # only needed for GBIF bulk downloads (not used by the app)
GBIF_PASSWORD=
CESIUM_API_KEY=         # same value as VITE_CESIUM_ION_TOKEN; used for the health readout only

# Browser (public by design; Vite exposes only VITE_* variables):
VITE_CESIUM_ION_TOKEN=  # Cesium ion token; without it the globe falls back to the offline NaturalEarth basemap

# v2 (all optional)
MEDIA_CONTACT_URL=      # your project/contact URL; Wikimedia Commons requires it in the User-Agent, photos skip Commons without it
GOOGLE_CSE_KEY=         # Google Programmable Search (image fallback); pending without it
GOOGLE_CSE_ID=
OPS_LLM_EXTRACTION=1    # 0 = never send extracted document text to Groq (rules-only extraction)
OPS_WORKFLOW=1          # 0 = no background HarvestOps research/trace runs
OPS_LITERATURE=1        # 0 = no OpenAlex candidate-literature search in cautions
PLANT_GLB_DIRECTORY=    # folder with plant .glb models for scripts/plant_assets.py (default: Plants/)

# HarvestOps mass-balance threshold: an assumed operational tolerance, not a scientific or legal standard.
# A drying/processing gap is flagged when it exceeds max(OPS_MASS_TOLERANCE_G grams, OPS_MASS_TOLERANCE_PCT % of input).
OPS_MASS_TOLERANCE_G=50
OPS_MASS_TOLERANCE_PCT=2
